# Reproduction outputs generated by scripts/rag_da_reproduce.py
result2/reproduce/

# Result folders contain generated artifacts. The public code repository keeps
# only README placeholders; publish results via GitHub Releases/Zenodo/Drive.
result2/**
!result2/
!result2/README.md

results/**
!results/
!results/README.md

# Dataset files are not committed by default. Keep only README placeholders and
# publish real benchmark files through external storage when licensing permits.
datasets/**
!datasets/
!datasets/README.md
!datasets/test/
!datasets/test/README.md
!datasets/train/
!datasets/train/README.md
!datasets/valid/
!datasets/valid/README.md
!datasets/bigvul_hf/
!datasets/bigvul_hf/README.md

# Large experiment logs and intermediate demonstration dumps.
# Keep compact summary JSON/XLSX artifacts when they are needed for paper tables.
result2/**/*_run.log
result2/**/run.log
result2/**/*_demos_full.jsonl
code_trans/**/*.jsonl
rag_common/

# FAISS indexes are generated artifacts tied to the local dataset release.
faiss/*.index

# Dataset-derived knowledge-base workbooks.
knowledge/*.xlsx

# Local database/index rebuild artifacts. Commit only the small metadata needed
# for reproducibility; publish large indexes through releases or external storage.
*.sqlite
*.db
*.dump
